{
  "name": "domace-financie",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local-first household finance desktop application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run setup:notices && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "test:e2e": "playwright test",
    "pretest": "npm rebuild better-sqlite3",
    "pretest:e2e": "electron-builder install-app-deps",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" package.json eslint.config.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "setup:notices": "node scripts/dependency-notices.mjs"
  },
  "build": {
    "appId": "sk.domacefinancie.desktop",
    "productName": "Dom\u00e1ce Financie",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Domace Financie",
      "icon": "assets/icons/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "extraResources": [
      {
        "from": "assets/ocr",
        "to": "ocr"
      },
      {
        "from": "assets/legal",
        "to": "legal"
      }
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "better-sqlite3": "13.1.1",
    "chokidar": "6.0.0",
    "image-size": "2.1.0",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron@45.3.1": true,
    "better-sqlite3@13.1.1": true
  },
  "homepage": "https://github.com/pulec10200/domacefinancie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulec10200/domacefinancie.git"
  },
  "license": "UNLICENSED",
  "desktopName": "domace-financie.desktop"
}
